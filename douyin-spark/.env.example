# ===== 服务端配置示例 =====
# 用法：复制为同目录下的 .env（本文件必须和 app.py 放在一起，程序只读同目录的 .env）
#   cp .env.example .env
# 多账号部署时建议不用 .env，改用 systemd 的 EnvironmentFile（见 docs/DEPLOY.md）

# 面板访问令牌：留空则不校验（本机自用可留空，公网必须设置）
# 生成：openssl rand -hex 16
AUTH_TOKEN=

# 访客只读令牌（可选）：持有者只能查看（GET），无法修改/发送/上传任何内容。
# 留空则关闭访客访问。生成方式和 AUTH_TOKEN 一样，但务必用不同的值。
# VISITOR_TOKEN=

# 服务监听端口
PORT=8000

# 监听地址：0.0.0.0 允许外部访问；接 nginx 反代后建议 127.0.0.1
HOST=0.0.0.0

# 数据目录：config.json / runtime.json / state.json / messages.jsonl 都放这里
# ⚠️ 变量名是 SPARK_DATA_DIR（不是 DATA_DIR）；多账号时每个账号指向不同目录
SPARK_DATA_DIR=./data

# 时区（定时任务按此时区解析 schedule_time）
TZ=Asia/Shanghai

# ===== 以下仅控制台 console/app.py 需要 =====
# 控制台口令：不设置则拒绝启动
# CONSOLE_PASSWORD=

# 账号数据根目录：控制台扫描 <ACCOUNTS_ROOT>/<账号名>/env
# ACCOUNTS_ROOT=/opt/douyin-spark-data

# 可选：告警 webhook（企业微信 / 钉钉 / 飞书）
# NOTIFY_WEBHOOK=
